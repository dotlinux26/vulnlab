<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : t('shop_name') %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/catalog">🛡️ <%= t('shop_name') %></a>
  <nav>
    <a href="/catalog"><%= t('nav_shop') %></a>
    <a href="/cart"><%= t('nav_cart') %></a>
    <a href="/objectives"><%= t('nav_objectives') %></a>
    <% if (user) { %>
      <a href="/orders"><%= t('nav_orders') %></a>
      <a href="/profile"><%= t('nav_profile') %></a>
      <a href="/notes"><%= t('nav_notes') %></a>
      <% if (user.role === 'admin') { %><a href="/admin"><%= t('nav_admin') %></a><% } %>
      <form method="POST" action="/logout" class="inline"><button class="linklike"><%= t('nav_logout') %> (<%= user.name %>)</button></form>
    <% } else { %>
      <a href="/login"><%= t('nav_login') %></a>
      <a href="/register"><%= t('nav_register') %></a>
    <% } %>
    <a class="lang" href="/lang/<%= lang === 'vi' ? 'en' : 'vi' %>"><%= t('lang_switch') %></a>
  </nav>
</header>
<main class="container">
