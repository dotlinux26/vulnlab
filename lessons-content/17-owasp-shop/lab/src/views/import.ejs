<%- include('partials/header', { title: t('import_title') }) %>
<div class="card">
  <h1><%= t('import_title') %></h1>
  <form method="POST" action="/import/xml" class="stacked">
    <textarea name="xml" rows="10" placeholder='<?xml version="1.0"?>
<products>
  <product><name>Cable</name><price>9</price><short_desc>USB-C</short_desc></product>
</products>'></textarea>
    <button type="submit"><%= t('import_btn') %></button>
  </form>
  <% if (result) { %>
    <p class="ok">Inserted <%= result.inserted %> product(s). Parser output:</p>
    <pre class="preview"><%= result.parsed %></pre>
  <% } %>
</div>
<%- include('partials/footer') %>
